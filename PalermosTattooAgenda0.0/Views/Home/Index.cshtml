@using PalermoAgenda.Application.DTOs

@{
    ViewData["Title"] = "Inicio";
    
    var artistas = ViewBag.Artistas
       as IEnumerable<ArtistaDTO> ?? new List<ArtistaDTO>();
    var trabajos = ViewBag.Trabajos
    as List<string> ?? new List<string>();

    var instagram = ViewBag.Instagram as List<PublicacionInstagram> ?? new List<PublicacionInstagram>();


    var horario = ViewBag.Horario
      as IEnumerable<HorarioDTO>
      ?? new List<HorarioDTO>();
    string[] dias = { "", "Lunes", "Martes",
      "Miércoles", "Jueves", "Viernes",
      "Sábado", "Domingo" };

    //Ubicacion del estudio (latitud,longitud)
    var q = "10.018289,-84.178778";
    string clave = ViewBag.MapsKey ?? "";
    //Sin clave: mapa basico de Google
    var urlMapa = "https://maps.google.com/maps?q="
      + q + "&z=17&output=embed";
    //Con clave: Maps Embed API
    if (!string.IsNullOrEmpty(clave))
    {
        urlMapa = "https://www.google.com/maps/embed/v1/"
          + "place?key=" + clave + "&q=" + q
          + "&zoom=17";
    }


    
}

<div id="exampleCarrusel" class="carousel slide" style="padding-top:1em">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#exampleCarrusel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#exampleCarrusel" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#exampleCarrusel" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/images/carrusel-1.jpeg" class="d-block w-100" alt="Catálogo" height="500">
            <div class="carousel-caption d-none d-md-block">
                <h5>Cátalogo</h5>
                <p>Amplio Catálogo de Servicios</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/carrusel-2.jpeg" class="d-block w-100" alt="Eventos" height="500">
            <div class="carousel-caption d-none d-md-block">
                <h5>Eventos</h5>
                <p>Acceso a suscripción de eventos y novedades</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/carrusel-3.jpeg" class="d-block w-100" alt="Comprar" height="500">
            <div class="carousel-caption d-none d-md-block">
                <h5>Comprar</h5>
                <p>Comprar de forma segura y rápida</p>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#exampleCarrusel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#exampleCarrusel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<section class="seccion-inicio">
  <h2 class="titulo-seccion">Nuestros artistas</h2>
  <div class="row row-cols-2 row-cols-md-4 g-4
              text-center">
    @foreach (var a in artistas.Where(x => x.Estado))
    {
      var foto = Url.Content(
        "~/images/artistas/" + a.Imagen);
      <div class="col">
        <img class="foto-artista mb-3" src="@foto"
             alt="@a.Nombre"
             onerror="this.src='/images/profile.png'" />
        <h5>@a.Nombre</h5>
        <p class="small text-muted">@a.Descripcion</p>
      </div>
    }
  </div>
</section>

    <section class="seccion-inicio">
        <h2 class="titulo-seccion">Trabajos recientes</h2>
        <div class="row row-cols-2 row-cols-md-4 g-3">
        @if (instagram.Any())
        {
            //Publicaciones reales de Instagram
            foreach (var p in instagram)
            {
                <div class="col">
                    <a href="@p.Enlace" target="_blank"
                       rel="noopener">
                        @if (p.Video != null)
                        {
                            <video class="w-100 rounded tarjeta-hover
                                          img-reciente"
                                   src="@p.Video"
                                   poster="@p.Imagen"
                                   autoplay muted loop playsinline>
                            </video>
                        }
                        else
                        {
                            <img class="img-fluid rounded w-100
                                        tarjeta-hover img-reciente"
                                 src="@p.Imagen"
                                 alt="Publicación de Instagram"
                                 loading="lazy" />
                        }
                    </a>
                </div>
            }
        }
        else
        {
            //Respaldo: fotos fijas de la galeria
            foreach (var nombre in trabajos)
            {
                var ruta = Url.Content(
                "~/images/Galeria/Trabajos/" + nombre);
                <div class="col">
                    <img class="img-fluid rounded w-100
                                tarjeta-hover img-reciente"
                         src="@ruta" alt="Trabajo realizado"
                         loading="lazy" />
                </div>
            }
        }
    </div>
        <div class="text-center mt-4">
            <a class="btn btn-primary btn-lg"
               asp-action="Galeria">
                <i class="bi bi-images"></i> Ver galería completa
            </a>
        <a class="btn btn-outline-light btn-lg ms-2"
           href="https://www.instagram.com/palermo.ttt/"
           target="_blank" rel="noopener">
            <i class="bi bi-instagram"></i> Síguenos
        </a>
        </div>
    </section>         

<section class="seccion-inicio">
    <h2 class="titulo-seccion">Horario</h2>
    <div class="table-responsive">
        <table class="table text-center mb-0">
            <thead>
                <tr>
                    @foreach (var h in horario)
                    {
                        <th>@dias[h.DiaSemana]</th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    @foreach (var h in horario)
                    {
                        <td>
                            @h.HoraInicio.ToString("HH:mm") -
                            @h.HoraFin.ToString("HH:mm")
                        </td>
                    }
                </tr>
            </tbody>
        </table>
    </div>
</section>

<section class="seccion-inicio">
    <h2 class="titulo-seccion">Ubícanos</h2>
    <div class="ratio ratio-21x9 rounded overflow-hidden">
        <div class="col-lg-8 mx-auto">
        <iframe class="mapa"
                src="@urlMapa"
                loading="lazy"
                allowfullscreen
                referrerpolicy="no-referrer-when-downgrade"
                title="Ubicación de Palermo's Tattoo">
        </iframe>
        </div>
    </div>
</section>

@section Scripts {
    <script type="text/javascript">
        const myCarouselElement = document.getElementById('exampleCarrusel')

        const carousel = new bootstrap.Carousel(myCarouselElement, {
          interval: 3000,
        })
    </script>
}
