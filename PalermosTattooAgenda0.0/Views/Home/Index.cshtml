@using PalermoAgenda.Application.DTOs
@{
    ViewData["Title"] = "Inicio";
    
    var artistas = ViewBag.Artistas
       as IEnumerable<ArtistaDTO> ?? new List<ArtistaDTO>();
    var trabajos = ViewBag.Trabajos
    as List<string> ?? new List<string>();
}

<div id="exampleCarrusel" class="carousel slide" style="padding-top:1em">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#exampleCarrusel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#exampleCarrusel" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#exampleCarrusel" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/images/carrusel-1.jpeg" class="d-block w-100" alt="Cátalogo" height="500">
            <div class="carousel-caption d-none d-md-block">
                <h5>Cátalogo</h5>
                <p>Amplio Cátalogo de Servicios</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/carrusel-2.jpeg" class="d-block w-100" alt="Eventos" height="500">
            <div class="carousel-caption d-none d-md-block">
                <h5>Eventos</h5>
                <p>Acceso a suscripción de eventos y novedades</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/carrusel-3.jpeg" class="d-block w-100" alt="Comprar" height="500">
            <div class="carousel-caption d-none d-md-block">
                <h5>Comprar</h5>
                <p>Comprar de forma segura y rápida</p>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#exampleCarrusel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#exampleCarrusel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<section class="seccion-inicio">
  <h2 class="titulo-seccion">Nuestros artistas</h2>
  <div class="row row-cols-2 row-cols-md-4 g-4
              text-center">
    @foreach (var a in artistas.Where(x => x.Estado))
    {
      var foto = Url.Content(
        "~/images/artistas/" + a.Imagen);
      <div class="col">
        <img class="foto-artista mb-3" src="@foto"
             alt="@a.Nombre"
             onerror="this.src='/images/profile.png'" />
        <h5>@a.Nombre</h5>
        <p class="small text-muted">@a.Descripcion</p>
      </div>
    }
  </div>
</section>

    <section class="seccion-inicio">
        <h2 class="titulo-seccion">Trabajos recientes</h2>
        <div class="row row-cols-2 row-cols-md-4 g-3">
            @foreach (var nombre in trabajos)
            {
                var ruta = Url.Content(
                "~/images/Galeria/Trabajos/" + nombre);
                <div class="col">
                    <img class="img-fluid rounded w-100
                            tarjeta-hover img-reciente"
                         src="@ruta" alt="Trabajo realizado"
                         loading="lazy" />
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a class="btn btn-primary btn-lg"
               asp-action="Galeria">
                <i class="bi bi-images"></i> Ver galería completa
            </a>
        </div>
    </section>

    <section class="seccion-inicio">
        <div class="row g-4">
            <div class="col-md-6">
                <h2 class="titulo-seccion">Horario</h2>
                <table class="table">
                    <tr>
                        <td>Lunes a viernes</td>
                        <td class="text-end">9:00 - 19:00</td>
                    </tr>
                    <tr>
                        <td>Sábado</td>
                        <td class="text-end">10:00 - 19:00</td>
                    </tr>
                    <tr>
                        <td>Domingo</td>
                        <td class="text-end">11:00 - 19:00</td>
                    </tr>
                </table>
            </div>
            <div class="col-md-6">
                <h2 class="titulo-seccion">Visítanos</h2>
                <p>
                    <i class="bi bi-geo-alt text-primary"></i>
                    Alajuela, Costa Rica
                </p>
                <p>
                    <i class="bi bi-whatsapp text-primary"></i>
                    6127-8904
                </p>
                <p>
                    <i class="bi bi-instagram text-primary"></i>
                    palermott
                </p>
            </div>
        </div>
    </section>

@section Scripts {
    <script type="text/javascript">
        const myCarouselElement = document.getElementById('exampleCarrusel')

        const carousel = new bootstrap.Carousel(myCarouselElement, {
          interval: 3000,
        })
    </script>
}
