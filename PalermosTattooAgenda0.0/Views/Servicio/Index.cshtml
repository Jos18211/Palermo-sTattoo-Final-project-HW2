@model IEnumerable<PalermoAgenda.Application.DTOs.ServicioDTO>
@{
    ViewData["Title"] = "Servicios";
}

<h1>Catálogo de servicios</h1>

<!-- Filtro por categoría (del lab, pero horizontal) -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <button type="button" class="btn btn-outline-primary btn-estilo active"
            onclick="buscarxEstilo('', this)">
        Todos
    </button>
    @foreach (var estilo in (List<string>)ViewBag.Estilos)
    {

        <button type="button" class="btn btn-outline-primary btn-estilo"
                onclick="buscarxEstilo('@estilo', this)">
            @estilo
        </button>
    }
</div>

<section>
    <div id="listaServicios" class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        @await Html.PartialAsync("_ListServicios", Model)
    </div>
</section>

@section Scripts {
    <script type="text/javascript">
        function buscarxEstilo(estilo, boton) {
            const divLista = document.getElementById("listaServicios")
            const myRequest = '@Url.Action("buscarxEstilo", "Servicio")'

            // Marcar el botón seleccionado
            document.querySelectorAll(".btn-estilo").forEach(b => b.classList.remove("active"))
            boton.classList.add("active")

            fetch(myRequest + "?estilo=" + estilo, { method: 'GET' })
                .then(function (response) {
                    if (!response.ok) {
                        return response.text().then(text => { throw new Error(text) })
                    }
                    return response.text()
                })
                .then((text) => {
                    divLista.innerHTML = text
                })
                .catch(error => {
                    Swal.fire({ title: "Error", text: error.message, icon: "error" })
                })
        }
    </script>
}