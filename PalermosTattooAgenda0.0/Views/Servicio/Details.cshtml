@model PalermoAgenda.Application.DTOs.ServicioDTO
@{
    ViewData["Title"] = "Detalle del servicio";
}

<div class="row g-4 mt-2">
    <div class="col-md-5">
        @if (Model.Imagen != null
                && Model.Imagen.Length > 0)
        {
            var b64 = Convert
            .ToBase64String(Model.Imagen);
            <img class="img-fluid rounded w-100"
                 src="data:image/jpeg;base64,@b64"
                 alt="@Model.Nombre" />
        }
        else
        {
            <div class="sin-imagen rounded"
                 style="height:320px">
                <i class="bi bi-brush"></i>
            </div>
        }
    </div>
    <div class="col-md-7">
        <h1>@Model.Nombre</h1>
        <span class="badge bg-secondary mb-3">
            @Model.Estilo
        </span>
        <p>@Model.Descripcion</p>
        <dl class="row">
            <dt class="col-sm-4">Precio</dt>
            <dd class="col-sm-8 fw-bold text-primary">
                &#8353;@Model.Precio.ToString("N0")
            </dd>
            <dt class="col-sm-4">Duración</dt>
            <dd class="col-sm-8">
                @Model.DuracionMinutos minutos
            </dd>
            <dt class="col-sm-4">Complejidad</dt>
            <dd class="col-sm-8">@Model.Complejidad</dd>
            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">
                <span class="badge @(Model.Estado ? "bg-success" : "bg-secondary")">@(Model.Estado ? "Activo" : "Inactivo")</span>
            </dd>
            <dt class="col-sm-4">Artistas</dt>
            <dd class="col-sm-8">
                @foreach (var a in Model.IdArtista)
                {
                    <span class="badge bg-primary me-1">
                        @a.Nombre
                    </span>
                }
            </dd>
        </dl>
        @{
            // Se llega desde el mantenimiento (IndexAdmin) o desde el catálogo (Index)
            bool desdeAdmin = Context.Request.Query["origen"] == "admin";
        }
        <div class="d-flex gap-2">
            @if (desdeAdmin)
            {
                <a asp-action="Edit" asp-route-id="@Model.IdServicio" class="btn btn-secondary">
                    <i class="bi bi-pencil-fill"></i> Editar
                </a>
            }
            <a class="btn btn-secondary" asp-action="@(desdeAdmin ? "IndexAdmin" : "Index")">
                <i class="bi bi-arrow-left"></i> @(desdeAdmin ? "Regresar al mantenimiento" : "Regresar al catálogo")
            </a>
        </div>
    </div>
</div>