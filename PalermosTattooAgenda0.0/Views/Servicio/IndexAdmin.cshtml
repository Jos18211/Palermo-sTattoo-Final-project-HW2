@model IEnumerable<PalermoAgenda.Application.DTOs.ServicioDTO>
@using X.PagedList;
@using X.PagedList.Mvc.Core;
@{
    ViewData["Title"] = "Mantenimiento Servicios";
}

<h1>Mantenimiento Servicios</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Crear</a>
</p>
<table class="table table-bordered table-hover">
    <thead>
        <tr class="table-primary">
            <th>
                @Html.DisplayNameFor(model => model.IdServicio)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estilo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Precio)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.Estado ? "" : "fila-inactiva")">
                <td>
                    @Html.DisplayFor(modelItem => item.IdServicio)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Estilo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Precio)
                </td>
                <td>
                    <div class="d-flex flex-wrap gap-1" role="group" aria-label="Acciones">
                        <a href="@Url.Action("Edit", new { id = item.IdServicio })" class="btn btn-secondary">
                            <i class="bi bi-pencil-fill"></i> Editar
                        </a>
                        <a href="@Url.Action("Details", new { id = item.IdServicio, origen = "admin" })" class="btn btn-info">
                            <i class="bi bi-zoom-in"></i> Detalle
                        </a>
                        @if (item.Estado)
                        {
                            <form asp-action="Delete" asp-route-id="@item.IdServicio" method="post" class="d-inline form-Inactivar">
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash-fill"></i> Inactivar
                                </button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary" disabled title="Puede reactivarlo desde Editar">
                                <i class="bi bi-slash-circle"></i> Inactivo
                            </button>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="6">
                <div class="btn-toolbar d-flex justify-content-end" role="toolbar">
                    <div class="btn-group" role="group">
                        @Html.PagedListPager((IPagedList)Model, page =>
                        Url.Action("IndexAdmin", new { page }), new PagedListRenderOptions
                        {
                            Display = PagedListDisplayMode.Always,
                            MaximumPageNumbersToDisplay = 5,
                            LiElementClasses = new String[] { "page-item" },
                            PageClasses = new String[] { "page-link" }
                        }
                                                )
                    </div>
                </div>
            </td>
        </tr>
    </tfoot>
</table>
@section Scripts {
    <script>
        document.querySelectorAll(".form-Inactivar").forEach(form => {
            form.addEventListener("submit", e => {
                e.preventDefault();
                Swal.fire({
                    title: "¿Inactivar servicio?",
                    text: "Dejará de mostrarse en el catálogo. Puede reactivarlo desde Editar.",
                    icon: "warning",
                    showCancelButton: true,
                    cancelButtonText: "Cancelar",
                    confirmButtonText: "Sí, Inactivar"
                }).then(r => { if (r.isConfirmed) form.submit(); });
            });
        });
    </script>
}