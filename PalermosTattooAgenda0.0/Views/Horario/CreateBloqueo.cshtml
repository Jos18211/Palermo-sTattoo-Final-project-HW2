@model PalermoAgenda.Application.DTOs.BloqueoDTO
@{
    ViewData["Title"] = "Nuevo bloqueo";
}

<h1>Nuevo bloqueo</h1>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="CreateBloqueo" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="IdArtista" class="form-label"></label>
                <select asp-for="IdArtista" asp-items="ViewBag.ListSucursales" class="form-select">
                    <option value="0">-- Seleccione una sucursal --</option>
                </select>
                <span asp-validation-for="IdArtista" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Fecha" class="form-label"></label>
                <input asp-for="Fecha" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="TodoElDia" class="form-check-input" id="chkTodoElDia" />
                <label asp-for="TodoElDia" class="form-check-label" for="chkTodoElDia"></label>
            </div>

            <div class="row" id="rangoHoras">
                <div class="col mb-3">
                    <label asp-for="HoraInicio" class="form-label"></label>
                    <input asp-for="HoraInicio" type="time" asp-format="{0:HH:mm}" class="form-control" />
                    <span asp-validation-for="HoraInicio" class="text-danger"></span>
                </div>
                <div class="col mb-3">
                    <label asp-for="HoraFin" class="form-label"></label>
                    <input asp-for="HoraFin" type="time" asp-format="{0:HH:mm}" class="form-control" />
                    <span asp-validation-for="HoraFin" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Motivo" class="form-label"></label>
                <textarea asp-for="Motivo" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Motivo" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-warning">Registrar bloqueo</button>
            <a asp-action="Index" asp-route-idArtista="@(Model.IdArtista > 0 ? Model.IdArtista : null)" class="btn btn-secondary">Regresar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Si es todo el día, las horas no aplican
        const chk = document.getElementById("chkTodoElDia");
        const rango = document.getElementById("rangoHoras");
        function toggleHoras() {
            rango.style.display = chk.checked ? "none" : "";
            rango.querySelectorAll("input").forEach(i => i.disabled = chk.checked);
        }
        chk.addEventListener("change", toggleHoras);
        toggleHoras();
    </script>
}
