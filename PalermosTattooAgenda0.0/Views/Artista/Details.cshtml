@model PalermoAgenda.Application.DTOs.ArtistaDTO

@{
    ViewData["Title"] = "Detalle de Artista";
}

<h1>Detalle</h1>
<div class="row">
    <div class="col">
        @if (Model.Imagen != null)
        {
            <img class="card-img-top"
                 style="max-width:460px;"
                 role="img"
                 src="data:image/jpeg;charset=utf-8;base64,@Convert.ToBase64String(Model.Imagen)" 
                 alt="Imagen" />
        }
    </div>
    <div class="col">
        <h4>Artista</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Nombre)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Nombre)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Descripcion)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Descripcion)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Telefono)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Telefono)
            </dd>
            
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Email)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Email)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Direccion)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Direccion)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.SelectedEncargados)
            </dt>
            <dd class="col-sm-8">
                @if (Model.Usuario != null && Model.Usuario.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var u in Model.Usuario)
                        {
                            <li><i class="bi bi-person-badge"></i> @u.Nombre (@u.Email)</li>
                        }
                    </ul>
                }
                else
                {
                    <span class="text-muted">Sin encargados asignados</span>
                }
            </dd>
            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">
                <span class="badge @(Model.Estado ? "bg-success" : "bg-secondary")">@(Model.Estado ? "Activo" : "Inactivo")</span>
            </dd>
        </dl>


    </div>
</div>

@{
    // Se llega desde el mantenimiento (IndexAdmin) o desde el catálogo (Index)
    bool desdeAdmin = Context.Request.Query["origen"] == "admin";
}
<div class="d-flex gap-2" role="group" aria-label="Acciones">
    @if (desdeAdmin)
    {
        <a href="@Url.Action("Edit", new { id = Model.IdArtista })" class="btn btn-secondary">
            <i class="bi bi-pencil-fill"></i> Editar
        </a>
    }
    <a asp-action="@(desdeAdmin ? "IndexAdmin" : "Index")" class="btn btn-info">
        <i class="bi bi-arrow-return-left"></i>
        @(desdeAdmin ? "Regresar al mantenimiento" : "Regresar al catálogo")
    </a>
</div>
