@model IEnumerable<PalermoAgenda.Application.DTOs.ArtistaDTO>

<h1>@ViewBag.Titulo</h1>

<p class="d-flex gap-2">
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo Artista</a>
    <a class="btn btn-secondary" asp-action="Enviar"><i class="bi bi-send"></i> Enviar</a>
</p>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdArtista)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.IdArtista)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    <div class="btn-group btn-group-sm">
                        <a class="btn btn-secondary" asp-action="Edit"
                           asp-route-id="@item.IdArtista">Editar</a>
                        <a class="btn btn-primary" asp-action="Details"
                           asp-route-id="@item.IdArtista">Detalle</a>
                        <a class="btn btn-danger" asp-action="Delete"
                           asp-route-id="@item.IdArtista">Eliminar</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>