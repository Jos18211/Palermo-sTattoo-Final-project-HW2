@model PalermoAgenda.Application.DTOs.ProductoDTO

@{
    ViewData["Title"] = "Detalle de producto";
}

<h1>Detalle</h1>
<div class="row">
    <div class="col">
        @if (Model.Imagen != null)
        {
            <img class="card-img-top"
                 style="max-width:460px;"
                 role="img"
                 src="data:image/jpeg;charset=utf-8;base64,@Convert.ToBase64String(Model.Imagen)"
                 alt="Imagen" />
        }
    </div>
    <div class="col">
        <h4>Producto</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">
                Categoría
            </dt>
            <dd class="col-sm-8">
                @Model.IdCategoriaProductoNavigation.Nombre
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Descripcion)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Descripcion)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Marca)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Marca)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Nombre)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Nombre)
            </dd>
           <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Precio)
            </dt>
            <dd class="col-sm-8 fw-bold text-primary">
                &#8353;@Model.Precio.ToString("N0")
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Presentacion)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Presentacion)
            </dd>
        </dl>
      

    </div>
</div>

<div class="btn-group" role="group" aria-label="Acciones">
    <a href="@Url.Action("Edit", new { id = Model.IdProducto })" class="btn btn-secondary">
        <i class="bi bi-pencil-fill"></i> Editar
    </a>
    <a asp-action="Index" class="btn btn-info">
        <i class="bi bi-arrow-return-left"></i>
        Regresar al listado
    </a>
</div>