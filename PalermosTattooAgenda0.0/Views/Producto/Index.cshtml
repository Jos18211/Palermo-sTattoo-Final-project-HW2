@model IEnumerable<PalermoAgenda.Application.DTOs.ProductoDTO>
@{
    ViewData["Title"] = "Productos";
}

<h1>Catálogo de productos</h1>

<!-- Filtro por categoría -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <button type="button" class="btn btn-outline-primary btn-categoria active"
            onclick="buscarxCategoria(0, this)">
        Todos
    </button>
    @foreach (var item in (IEnumerable<PalermoAgenda.Application.DTOs.CategoriaDTO>)ViewBag.ListCategorias)
    {
        <button type="button" class="btn btn-outline-primary btn-categoria"
                onclick="buscarxCategoria(@item.IdCategoriaProducto, this)">
            @item.Nombre
        </button>
    }
</div>

<section>
    <div id="listaProductos" class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        @await Html.PartialAsync("_ListProductos", Model)
    </div>
</section>

@section Scripts {
    <script type="text/javascript">
        function buscarxCategoria(IdCategoria, boton) {
            const divLista = document.getElementById("listaProductos")
            const myRequest = '@Url.Action("buscarxCategoria", "Producto")'

            // Marcar el botón seleccionado
            document.querySelectorAll(".btn-categoria").forEach(b => b.classList.remove("active"))
            boton.classList.add("active")

            fetch(myRequest + "?IdCategoria=" + IdCategoria, { method: 'GET' })
                .then(function (response) {
                    if (!response.ok) {
                        return response.text().then(text => { throw new Error(text) })
                    }
                    return response.text()
                })
                .then((text) => {
                    divLista.innerHTML = text
                })
                .catch(error => {
                    Swal.fire({ title: "Error", text: error.message, icon: "error" })
                })
        }
    </script>
}