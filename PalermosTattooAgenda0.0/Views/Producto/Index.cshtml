@model IEnumerable<PalermoAgenda.Application.DTOs.ProductoDTO>

@{
    ViewData["Title"] = "Index";
}

<h1>Catalogo de Productos</h1>

<section>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm tarjeta-hover">
                    @if (item.Imagen != null)
                    {

                        var b64 = Convert.ToBase64String(item.Imagen);
                        <img class="card-img-top img-producto"
                             src="data:image/jpeg;base64,@b64"
                             alt="@item.Nombre" />
                    }

                    <div class="card-body">
                        <h5 class="card-title">@item.Nombre</h5>
                        <p class="text-muted mb-1">@item.IdCategoriaProductoNavigation?.Nombre</p>
                        <p class="mb-1">@item.Marca</p>

                        <p class="fs-5 fw-bold text-primary mb-0"> &#8353;@item.Precio.ToString("N0")</p>
                    </div>
                    <div class="card-footer bg-transparent border-0">
                        <a class="btn btn-primary w-100" asp-action="Details"
                           asp-route-id="@item.IdProducto">
                           <i class="bi bi-zoom-in"></i> Detalle</a>

                    </div>
                </div>
            </div>
        }
    </div>
</section>