@model PalermosTattooAgenda0.Web.ViewModels.ViewModelInput
<div class="row" id="MyAddProducto">
    <div class="col-md-4">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">

         
            <input id="ProductoBuscar" type="text" autocomplete="off" class="form-control form-control-sm" placeholder="Nombre del producto" />
            <input type="hidden" id="IdProductoModal" />
            <span asp-validation-for="IdProducto" class="text-danger"></span>
            <!--Hidden field with stock-->
            <input type="hidden" id="CantidadEnInventarioModal" />
        </div>
        <div class="form-group">
            <label asp-for="Cantidad" class="control-label"></label>
            <input asp-for="Cantidad" id="CantidadModal" type="number" class="form-control form-control-sm" />
            <span asp-validation-for="Cantidad" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Precio" class="control-label"></label>
            <input asp-for="Precio" id="Precio" readonly type="number" class="form-control  form-control-sm" />
            <span asp-validation-for="Precio" class="text-danger"></span>
        </div>
        <br />
        <!--Call JavaScript addLibro -->
        <button type="button" class="btn btn-success" onclick="addProducto()">Comprar Producto</button>
    </div>
    <div class="col-md-4 text-center">
        <img src="/Images/nophoto.png" class="img-responsive" style="height:80%;width:80%" id="ImgProducto">
    </div>
    <div class="col-md-4 text-left">
        <p id="ProductoSelect" name="ProductoSelect" class="form-label fw-bold">Producto: -</p>
        <p id="PrecioSelect" name="PrecioSelect" class="form-label fw-bold">Precio: -</p>
        <p id="CantidadSelect" name="CantidadSelect" class="form-label fw-bold">Cantidad Stock: -</p>
    </div>
</div>

