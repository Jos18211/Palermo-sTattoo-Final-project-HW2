@model IEnumerable<PalermoAgenda.Application.DTOs.FacturaDTO>

@{
    ViewData["Title"] = "Facturas";
}

<h1>Facturas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Factura</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdFactura)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaFactura)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdClienteNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Total)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.IdFactura)
                </td>
                <td>
                    @item.FechaFactura.ToString("dd-MM-yyyy")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IdClienteNavigation.Nombre)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Total)
                </td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.IdFactura"
                       class="btn btn-info">Detalle</a>
                </td>
            </tr>
        }
    </tbody>
</table>