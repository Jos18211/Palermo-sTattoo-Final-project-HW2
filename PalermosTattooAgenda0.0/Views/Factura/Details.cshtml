@model PalermoAgenda.Application.DTOs.FacturaDTO
@{
    ViewBag.Title = "Detalle Factura";
    var cli = Model.IdClienteNavigation;
    var art = Model.IdArtistaNavigation;
}
<div class="d-flex flex-wrap
            justify-content-between
            align-items-center">
    <h1>Factura #@Model.IdFactura</h1>
    <span class="badge  fs-6" style="background-color:#198754">
        @Model.Estado
    </span>
</div>
<p class="text-muted">
    Fecha: @Model.FechaFactura.ToString("dd-MM-yyyy")
</p>
<div class="row g-3">
    <div class="col-lg-4 d-flex flex-column gap-3">
        <div class="card card-detalle">
            <div class="card-header">
                <i class="bi bi-person"></i> Cliente
            </div>
            <div class="card-body">
                <div class="dato">
                    <small>Nombre</small>@cli.Nombre
                </div>
                <div class="dato">
                    <small>Identificación</small>
                    @cli.Identificacion
                </div>
            </div>
        </div>
        <div class="card card-detalle">
            <div class="card-header">
                <i class="bi bi-brush"></i> Artista
            </div>
            <div class="card-body">
                <div class="dato">
                    <small>Nombre</small>@art.Nombre
                </div>
                <div class="dato">
                    <small>Teléfono</small>@art.Telefono
                </div>
                <div class="dato">
                    <small>Dirección</small>@art.Direccion
                </div>
                <div class="dato">
                    <small>Correo</small>@art.Email
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card card-detalle">
            <div class="card-header">
                <i class="bi bi-receipt"></i> Detalle
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Producto / Servicio</th>
                            <th class="text-end">Cantidad</th>
                            <th class="text-end">Precio</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.FacturaDetalle)
                        {
                            var nombre =
                            item.IdProductoNavigation?.Nombre
                            ?? item.IdServicioNavigation?.Nombre;
                            <tr>
                                <td>@nombre</td>
                                <td class="text-end">@item.Cantidad</td>
                                <td class="text-end">
                                    &#8353;@item.PrecioUnitario.ToString("N2")
                                </td>
                                <td class="text-end">
                                    &#8353;@item.Subtotal.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end">
                                Subtotal
                            </td>
                            <td class="text-end">
                                &#8353;@Model.Subtotal.ToString("N2")
                            </td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end">
                                IVA
                                @Model.PorcentajeImpuesto.ToString("0.##")%
                            </td>
                            <td class="text-end">
                                &#8353;@Model.MontoImpuesto.ToString("N2")
                            </td>
                        </tr>
                        <tr class="fs-5 fw-bold">
                            <td colspan="3" class="text-end">Total</td>
                            <td class="text-end text-primary">
                                &#8353;@Model.Total.ToString("N2")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<a class="btn btn-secondary mt-3" asp-action="Index">
    <i class="bi bi-arrow-left"></i> Regresar al listado
</a>