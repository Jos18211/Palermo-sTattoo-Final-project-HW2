@model PalermoAgenda.Application.DTOs.CitaDTO

@{
    ViewBag.Title = "Detalle de la Reserva";
    var estado = Model.IdEstadoCitaNavigation;
    var cli = Model.IdClienteNavigation;
    var art = Model.IdArtistaNavigation;
    var srv = Model.IdServicioNavigation;
}
<div class="d-flex flex-wrap
            justify-content-between
            align-items-center">
    <h1>Reserva #@Model.IdCita</h1>
    <span class="badge fs-6"
          style="background-color:@estado.Color">
        @estado.Nombre
    </span>
</div>
<p class="text-muted">
    Creada el
    @Model.FechaCreacion.ToString("dd-MM-yyyy HH:mm")
</p>
<div class="row g-3">
    <div class="col-lg-4">
        <div class="card card-detalle h-100">
            <div class="card-header">
                <i class="bi bi-calendar-event"></i> Cita
            </div>
            <div class="card-body">
                <div class="dato">
                    <small>Fecha</small>
                    @Model.Fecha.ToString("dd-MM-yyyy")
                </div>
                <div class="dato">
                    <small>Horario</small>
                    @Model.HoraInicio.ToString("HH:mm") -
                    @Model.HoraFin.ToString("HH:mm")
                </div>
          
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card card-detalle h-100">
            <div class="card-header">
                <i class="bi bi-person"></i> Cliente
            </div>
            <div class="card-body">
                <div class="dato">
                    <small>Nombre</small>@cli.Nombre
                </div>
                <div class="dato">
                    <small>Teléfono</small>@cli.Telefono
                </div>
                <div class="dato">
                    <small>Correo</small>@cli.Email
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card card-detalle h-100">
            <div class="card-header">
                <i class="bi bi-brush"></i> Artista
            </div>
            <div class="card-body">
                <div class="dato">
                    <small>Nombre</small>@art.Nombre
                </div>
                <div class="dato">
                    <small>Teléfono</small>@art.Telefono
                </div>
                <div class="dato">
                    <small>Correo</small>@art.Email
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-detalle h-100">
            <div class="card-header">
                <i class="bi bi-tag"></i> Servicio
            </div>
            <div class="card-body">
                <div class="dato">
                    <small>Servicio</small>@srv.Nombre
                </div>
                <div class="dato">
                    <small>Estilo</small>@srv.Estilo
                </div>
                <div class="dato">
                    <small>Precio</small>
                    <span class="fw-bold text-primary">
                        &#8353;@srv.Precio.ToString("N0")
                    </span>
                </div>
            </div>
        </div>
    </div>
     <div class="col-lg-6">
        <div class="card card-detalle h-100">
            <div class="card-header">
                <i class="bi bi-question-circle"></i>
                Preguntas previas
            </div>
            <div class="card-body">
                <div class="dato">
                    <small>
                        1. ¿En qué zona del cuerpo
                        será el tatuaje?
                    </small>
                    @Model.ZonaCuerpo
                </div>
                <div class="dato">
                    <small>2. ¿Tiene alguna alergia?</small>
                    @(Model.TieneAlergias ? "Sí" : "No")
                    @if (Model.TieneAlergias)
                    {
                        <span>- @Model.DetalleAlergias</span>
                    }
                </div>
                <div class="dato">
                    <small>
                        3. ¿Tiene una referencia
                        del diseño?
                    </small>
                    @(Model.ReferenciaDiseno
                      ?? "No, se diseñará en la consulta")
                </div>
            </div>
        </div>
    </div>
</div>
<a class="btn btn-secondary mt-3" asp-action="Index">
    <i class="bi bi-arrow-left"></i> Regresar al listado
</a>